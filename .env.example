AUDIO_UPLOAD_DIR=apps/api/uploads

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
MEDICAL_INITIAL_PROMPT=Transcribe medical dictation clearly, including drug names, vitals, and units.