DATABASE_URL=postgresql://medical_user:medical_password@localhost:5432/medical_stt?schema=public
PORT=3000
STT_SERVICE_URL=http://localhost:8000
STT_TIMEOUT_MS=120000
STT_RETRIES=2
TRANSCRIPTION_JOB_TIMEOUT_MS=90000
PROCESSING_STALE_TIMEOUT_MS=120000
MAX_UPLOAD_MB=40
